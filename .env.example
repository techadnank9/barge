# Copy to .env and fill in. NEVER commit real keys. Rotate anything exposed.

# --- a1mobile ---
TEAM_KEY=team-REPLACE_ME

# --- LLM (generate-on-miss for non-seed songs) ---
# Option A: your own OpenAI key
OPENAI_API_KEY=sk-REPLACE_ME
LLM_MODEL=gpt-4o-mini
# Option B: a1mobile gateway (saves budget) - set these instead:
# OPENAI_API_KEY=a1hk_REPLACE_ME
# OPENAI_BASE_URL=https://hack.a1mobile.com/gw/v1
# LLM_MODEL=openai.gpt-5.6-sol

# --- Supabase (server-side services use the service-role key) ---
SUPABASE_URL=https://REPLACE.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_ONLY

# --- ports ---
PHONE_PORT=5000
MCP_PORT=8000

# --- Next.js dashboard (web/.env.local) uses the ANON key, not service role ---
# NEXT_PUBLIC_SUPABASE_URL=https://REPLACE.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_PUBLIC_ANON
